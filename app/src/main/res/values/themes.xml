<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LightShadowArtPhone" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/card</item>
    </style>

    <!-- parent="" 关闭点号前缀的隐式继承，避免 AAPT 找不到 style/Text -->
    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.Hint" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
