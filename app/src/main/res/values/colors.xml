<?xml version="1.0" encoding="utf-8"?>
<!--
    Design tokens for the mobile app (UI PRD v2.0 §2.1, warm light cyan-blue).

    Every colour / size used by a layout must come from here or from dimens.xml /
    themes.xml: layouts must not carry literal colour values.
-->
<resources>

    <!-- Surfaces -->
    <color name="app_bg">#EAF5F6</color>
    <color name="app_bg_top">#F4FAF9</color>
    <color name="card_bg">#FFFFFF</color>
    <color name="card_tint">#F7FBFA</color>

    <!-- Primary action blue -->
    <color name="primary_blue">#287EAD</color>
    <color name="on_primary">#FFFFFF</color>

    <!-- Accents: a little teal / sky for status and decoration only -->
    <color name="accent_teal">#64B8BD</color>
    <color name="accent_sky">#B8E0EA</color>

    <!-- Text -->
    <color name="text_primary">#172F3B</color>
    <color name="text_secondary">#526E79</color>
    <color name="text_disabled">#9BB0B8</color>

    <!-- Lines and strokes -->
    <color name="divider_stroke">#D5E5E8</color>

    <!-- Semantic states: always paired with an icon or a word, never colour alone -->
    <color name="status_connected">#368C79</color>
    <color name="status_destructive">#C85C5C</color>

    <!--
        Soft shadow tint. The UI PRD writes it as `#163F5012`; read as the shadow colour
        `#163F50` at roughly 8% alpha, which is what elevation renders as a very light halo.
    -->

    <!-- Media grid heart marker (the framework has no heart drawable) -->
    <color name="favourite">#E53935</color>

    <!-- Preview boundary of the user wallpaper canvas (mobile preview only) -->
    <color name="frame_boundary">#FFFF0000</color>

    <!-- Scrim behind the expanded device control pad -->
    <color name="scrim">#1A172F3B</color>

    <!-- Tint laid over a selected gallery thumbnail -->
    <color name="selection_overlay">#66287EAD</color>

    <!--
        Legacy aliases kept so not-yet-migrated screens keep compiling while the UI
        refactor moves page by page; they point at the v2.0 tokens above.
    -->
    <color name="primary">@color/primary_blue</color>
    <color name="card">@color/card_bg</color>
    <color name="divider">@color/divider_stroke</color>
    <color name="success">@color/status_connected</color>
    <color name="error">@color/status_destructive</color>
    <color name="icon_muted">@color/text_disabled</color>

    <!-- Translucent surfaces used by the gallery overlays and badges -->
    <color name="surface_translucent">#F2FFFFFF</color>
    <color name="surface_translucent_strong">#E6FFFFFF</color>
    <color name="badge_scrim">#B3172F3B</color>
    <color name="card_highlight_end">#E8F2F4</color>
</resources>
