<?xml version="1.0" encoding="utf-8"?>
<!--
    Design tokens for the mobile app (UI PRD v3.0 §2.1, cool light grey + white + tech blue).

    Every colour / size used by a layout must come from here or from dimens.xml /
    themes.xml: layouts must not carry literal colour values.
-->
<resources>

    <!-- Surfaces -->
    <color name="app_bg">#F5F6F8</color>
    <color name="card_bg">#FFFFFF</color>
    <color name="card_tint">#F5F6F8</color>

    <!-- Primary action blue -->
    <color name="primary_blue">#2F6FED</color>
    <color name="on_primary">#FFFFFF</color>

    <!-- Derived light tint of primary: icon plates only -->
    <color name="primary_soft">#E9EFFD</color>

    <!-- Text -->
    <color name="text_primary">#1A1C1E</color>
    <color name="text_secondary">#6B7280</color>
    <color name="text_disabled">#C3C7CF</color>

    <!-- Lines and strokes -->
    <color name="divider_stroke">#E2E4E8</color>

    <!-- Semantic states: always paired with an icon or a word, never colour alone -->
    <color name="status_connected">#1B8A5A</color>
    <color name="status_warning">#E8A33D</color>
    <color name="status_destructive">#C0392B</color>

    <!-- Heart markers (thumbnail + full-screen frame): white, per the 2026-10-20 UI fine-tune -->
    <color name="favourite">#FFFFFF</color>

    <!-- Preview boundary of the user wallpaper canvas (mobile preview only) -->
    <color name="frame_boundary">#FFFF0000</color>

    <!-- Scrim behind the expanded device control pad -->
    <color name="scrim">#1A1A1C1E</color>

    <!-- Tint laid over a selected gallery thumbnail -->
    <color name="selection_overlay">#662F6FED</color>

    <!-- Multi-select square marker backdrop: dark enough for the white outline to read on any photo -->
    <color name="check_backdrop">#33000000</color>

    <!--
        Legacy aliases kept so not-yet-migrated screens keep compiling while the UI
        refactor moves page by page; they point at the v3.0 tokens above.
    -->
    <color name="primary">@color/primary_blue</color>
    <color name="card">@color/card_bg</color>
    <color name="divider">@color/divider_stroke</color>
    <color name="success">@color/status_connected</color>
    <color name="error">@color/status_destructive</color>
    <color name="icon_muted">@color/text_disabled</color>

    <!-- Translucent surfaces used by the gallery overlays and badges -->
    <!-- 70% opacity (was #F2FFFFFF / 95%): the gallery bottom bar lets the artwork show through -->
    <color name="surface_translucent">#B3FFFFFF</color>
    <color name="surface_translucent_strong">#E6FFFFFF</color>
    <color name="badge_scrim">#B31A1C1E</color>

    <!-- Scan page: dark scrim over the live camera feed, with white copy on top of it -->
    <color name="scan_scrim">#B3000000</color>
    <color name="on_scrim">#FFFFFF</color>
    <color name="on_scrim_secondary">#E6FFFFFF</color>
</resources>
