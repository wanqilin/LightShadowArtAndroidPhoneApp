<?xml version="1.0" encoding="utf-8"?>
<!--
    Spacing / corner / type scale tokens (UI PRD v3.0 §2.2, §2.3).

    Layouts and styles must reference these instead of literal dp / sp values so the
    spacing system stays consistent across pages.
-->
<resources>

    <!-- Corners -->
    <dimen name="corner_large">22dp</dimen>
    <dimen name="corner_pill">28dp</dimen>
    <dimen name="corner_image">8dp</dimen>
    <dimen name="corner_small">12dp</dimen>

    <!-- Page rhythm -->
    <dimen name="page_horizontal_padding">20dp</dimen>
    <dimen name="page_vertical_padding">24dp</dimen>
    <dimen name="card_padding">18dp</dimen>
    <dimen name="section_gap">14dp</dimen>
    <dimen name="item_gap">10dp</dimen>

    <!-- Cards -->
    <dimen name="card_elevation">2dp</dimen>
    <dimen name="divider_width">1dp</dimen>
    <!-- Dashboard 2x2 entry cards: fixed so both columns and both rows stay equal -->
    <dimen name="dashboard_card_height">140dp</dimen>
    <!-- Dashboard brand disc, its mark, and the spacing around the brand block -->
    <dimen name="dashboard_logo_size">116dp</dimen>
    <dimen name="text_dashboard_logo">36sp</dimen>
    <dimen name="text_dashboard_brand">26sp</dimen>
    <dimen name="dashboard_brand_gap">32dp</dimen>
    <dimen name="dashboard_brand_top_offset">54dp</dimen>
    <!-- Brand state dot and the rhythm below the brand name -->
    <dimen name="dashboard_dot_size">8dp</dimen>
    <dimen name="dashboard_dot_gap">8dp</dimen>
    <dimen name="dashboard_subtitle_gap">8dp</dimen>
    <!-- Minimum gap between the brand block and the bottom-anchored card group -->
    <dimen name="dashboard_card_group_min_gap">28dp</dimen>
    <!-- Bottom gap of the 2x2 card group: the 14dp baseline (section_gap) plus two 12dp lifts
         requested on 2026-10-18, which moves all four cards up by 24dp -->
    <dimen name="dashboard_card_group_bottom_gap">38dp</dimen>

    <!-- Welcome guide brand block, language choice and bottom action -->
    <dimen name="welcome_logo_size">116dp</dimen>
    <dimen name="text_welcome_logo">36sp</dimen>
    <dimen name="welcome_title_gap">32dp</dimen>
    <dimen name="welcome_subtitle_gap">8dp</dimen>
    <dimen name="welcome_language_gap">56dp</dimen>
    <dimen name="welcome_start_bottom_gap">24dp</dimen>

    <!-- Bind device guide: illustration size, gap below the step label, and the gap between the
         bottom action block and the page bottom. The root layout draws edge-to-edge (window frame
         reported by uiautomator ends ~47dp above the physical bottom), so the visual 44dp baseline
         plus the requested 20dp lift lands at 64dp against the physical screen bottom. -->
    <dimen name="bind_guide_image_width">280dp</dimen>
    <dimen name="bind_guide_image_height">182dp</dimen>
    <dimen name="bind_guide_top_gap">64dp</dimen>
    <dimen name="bind_action_bottom_gap">64dp</dimen>

    <!-- Controls: 48dp is the minimum touch target (UI PRD §5) -->
    <dimen name="touch_min_height">48dp</dimen>
    <dimen name="top_bar_height">56dp</dimen>
    <dimen name="icon_touch_size">44dp</dimen>
    <dimen name="icon_badge_box">40dp</dimen>

    <!-- Media grid -->
    <dimen name="space_grid_spacing">6dp</dimen>

    <!-- Gallery overlays -->
    <dimen name="floating_toolbar_height">66dp</dimen>
    <dimen name="control_pad_diameter">168dp</dimen>
    <dimen name="control_pad_key_size">52dp</dimen>
    <dimen name="control_pad_center_size">56dp</dimen>
    <dimen name="control_pad_entry_size">52dp</dimen>
    <dimen name="control_pad_entry_bottom_margin">88dp</dimen>
    <dimen name="control_pad_panel_bottom_margin">150dp</dimen>
    <dimen name="gallery_bottom_inset">92dp</dimen>

    <!-- Type scale (UI PRD v3.0 §2.2): title_large 24 Bold, title 20 Bold, page_title 18 Normal -->
    <dimen name="text_title_large">24sp</dimen>
    <dimen name="text_title">20sp</dimen>
    <dimen name="text_page_title">18sp</dimen>
    <dimen name="text_title_medium">18sp</dimen>
    <dimen name="text_row_title">16sp</dimen>
    <dimen name="text_button">15sp</dimen>
    <dimen name="text_body">15sp</dimen>
    <dimen name="text_hint">13sp</dimen>
    <dimen name="text_label">12sp</dimen>
</resources>
