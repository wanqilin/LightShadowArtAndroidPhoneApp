<?xml version="1.0" encoding="utf-8"?>
<!--
    Switch thumb: white on the primary track when on, a readable grey when off. The Material default
    off-state thumb is colorOutline, which this theme sets to the very light divider grey.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/on_primary" android:state_checked="true" />
    <item android:color="@color/text_secondary" />
</selector>
