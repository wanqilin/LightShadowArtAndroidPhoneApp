<?xml version="1.0" encoding="utf-8"?>
<!--
    App shell (UI PRD §1.3): one container hosting the Dashboard and its two sub-pages.
    The bottom tab bar is deliberately gone — the Dashboard cards are the entry points.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <include
        android:id="@+id/view_dashboard"
        layout="@layout/view_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/view_space"
        layout="@layout/view_space"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/view_settings"
        layout="@layout/view_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
