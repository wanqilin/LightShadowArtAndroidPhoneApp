<?xml version="1.0" encoding="utf-8"?>
<!-- Gallery cell: rounded square thumbnail plus video badge, favourite heart and multi-select mark -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_grid_spacing">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_thumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_media_placeholder"
        android:contentDescription="@string/space_title"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Image" />

    <View
        android:id="@+id/view_select_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/selection_overlay"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_video_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:background="@drawable/bg_badge_solid"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="@string/space_video_badge"
        android:textColor="@color/on_primary"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Heart shares the top-right corner with the video badge, so it clears the badge width -->
    <ImageView
        android:id="@+id/iv_favourite"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="40dp"
        android:contentDescription="@string/space_favourite"
        android:src="@drawable/ic_favourite"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/favourite" />

    <!--
        Multi-select marker: square, bottom-right, empty outline when unselected and primary filled
        with a white check when selected (UI PRD §3.6 C / F). Only shown while selecting.
    -->
    <ImageView
        android:id="@+id/iv_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_margin="6dp"
        android:background="@drawable/bg_check_square_off"
        android:contentDescription="@string/space_selected_marker_desc"
        android:padding="3dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
