<?xml version="1.0" encoding="utf-8"?>
<!--
    边框预设编辑（需求 3.3.1 / T-13）。
    只在移动端改参数、下发到设备端；设备端按「运行期值优先于 DeviceConfig 默认值」渲染。
    颜色用 #RRGGBB 文本输入并配实时预览：设备屏就在眼前，最终观感以设备屏为准。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp">

        <TextView
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frame_style" />

        <Spinner
            android:id="@+id/spinner_frame_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/frame_line_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_frame_line_color"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/frame_color_hint"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <View
                android:id="@+id/view_frame_line_preview"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/frame_line_width" />

        <EditText
            android:id="@+id/et_frame_line_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <TextView
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/frame_line_gap" />

        <EditText
            android:id="@+id/et_frame_line_gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <TextView
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/frame_paper_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_frame_paper_color"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/frame_color_hint"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <View
                android:id="@+id/view_frame_paper_preview"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_frame_paper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/frame_paper_enabled" />
    </LinearLayout>
</ScrollView>
