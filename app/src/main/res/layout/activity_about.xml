<?xml version="1.0" encoding="utf-8"?>
<!--
    About and Version (UI PRD §3.7 sub-page): app icon and name, the real mobile version, the
    firmware version reported by the device, and the copyright line pinned to the page bottom.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <com.ShowSeen.lightshadowart.mobile.PageTopBarView
        android:id="@+id/about_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="@dimen/card_padding" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_horizontal_padding"
            android:paddingTop="@dimen/page_vertical_padding"
            android:paddingEnd="@dimen/page_horizontal_padding"
            android:paddingBottom="@dimen/page_vertical_padding">

            <ImageView
                android:layout_width="@dimen/about_logo_size"
                android:layout_height="@dimen/about_logo_size"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/about_app_icon_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_brand_logo" />

            <com.google.android.material.card.MaterialCardView
                style="@style/SurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/page_vertical_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/Settings.Row">

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_label_mobile_version" />

                        <TextView
                            android:id="@+id/tv_about_mobile_version"
                            style="@style/Text.RowValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/Settings.Divider" />

                    <LinearLayout style="@style/Settings.Row">

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_label_device_version" />

                        <TextView
                            android:id="@+id/tv_about_device_version"
                            style="@style/Text.RowValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Copyright hugs the bottom of the page even when the content is shorter than the screen -->
    <TextView
        android:id="@+id/tv_about_copyright"
        style="@style/Text.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="@dimen/item_gap"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="@dimen/page_vertical_padding" />
</LinearLayout>
