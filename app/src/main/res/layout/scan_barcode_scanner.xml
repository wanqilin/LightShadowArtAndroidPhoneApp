<?xml version="1.0" encoding="utf-8"?>
<!--
    自定义取景布局：与 ZXing 内置 zxing_barcode_scanner 同构，
    额外加入顶部标题（scan_title），并沿用底部提示（zxing_status_view）。
    两个文字视图由 ScanDecoratedBarcodeView 定位到取景框的上/下方。
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <com.ShowSeen.lightshadowart.mobile.scan.ScanBarcodeView
        android:id="@+id/zxing_barcode_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.journeyapps.barcodescanner.ViewfinderView
        android:id="@+id/zxing_viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/scan_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:text="@string/scan_title"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/zxing_status_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:text="@string/scan_prompt"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="invisible" />
</merge>
