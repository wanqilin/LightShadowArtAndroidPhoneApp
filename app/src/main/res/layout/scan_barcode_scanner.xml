<?xml version="1.0" encoding="utf-8"?>
<!--
    Scanner layout plugged into DecoratedBarcodeView (UI PRD §3.2 B). Only the preview surface and
    the viewfinder are declared: the library inflates this in place of its stock layout and requires
    both ids to exist. The viewfinder is kept but never shown — the page has no centered framing
    box, and the copy lives in activity_scan.xml instead.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <com.ShowSeen.lightshadowart.mobile.scan.ScanBarcodeView
        android:id="@+id/zxing_barcode_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.journeyapps.barcodescanner.ViewfinderView
        android:id="@+id/zxing_viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</merge>
