<?xml version="1.0" encoding="utf-8"?>
<!--
    Space Art Gallery (UI PRD §3.6). Top: back + title + read-only playback capsule, switching to a
    multi-select header (cancel / selected count / select all) while a long-press selection is active.
    Below it the three views are one control — TabLayout driving a ViewPager2, each page a three-column
    grid — wrapped in a pull-to-refresh container, with the floating device control pad on top.
    The artwork area swaps to a single scaled frame while the device plays. Two bottom toolbars are
    hidden by default and shown per state (UI PRD §3.6 D): multi-select shows favourite / delete /
    export favourites, a paused full-screen frame shows favourite / frame / wallpaper / rotate.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <com.ShowSeen.lightshadowart.mobile.PageTopBarView
        android:id="@+id/space_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="@dimen/card_padding" />

    <!-- Multi-select header: same height as the top bar so switching does not shift the page -->
    <LinearLayout
        android:id="@+id/space_select_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_space_cancel"
            style="@style/Text.RowTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/space_cancel"
            android:textColor="@color/primary_blue" />

        <TextView
            android:id="@+id/tv_space_selected"
            style="@style/Text.RowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1" />

        <TextView
            android:id="@+id/btn_space_select_all"
            style="@style/Text.RowTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/space_select_all"
            android:textColor="@color/primary_blue" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/primary_blue"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="@color/primary_soft" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <!-- Pull-to-refresh wraps the pager, so a vertical pull reloads the current view (§3.6 I) -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_space"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pager_space"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Now Playing: one scaled frame, tap to toggle auto play / pause (UI PRD §3.6 C2) -->
        <FrameLayout
            android:id="@+id/now_playing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_bg"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_now_playing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/page_horizontal_padding"
                android:layout_marginEnd="@dimen/page_horizontal_padding"
                android:layout_marginBottom="@dimen/gallery_bottom_inset"
                android:contentDescription="@string/space_now_playing_desc"
                android:scaleType="fitCenter" />

            <!-- Favourite marker for the paused frame: follows the device marker immediately -->
            <ImageView
                android:id="@+id/iv_now_playing_favourite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/item_gap"
                android:layout_marginEnd="@dimen/page_horizontal_padding"
                android:contentDescription="@string/space_favourite"
                android:src="@drawable/ic_favourite"
                android:visibility="gone"
                app:tint="@color/favourite" />

            <ProgressBar
                android:id="@+id/progress_now_playing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tv_now_playing_status"
                style="@style/Text.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Empty state: only shown when the current view really has nothing -->
        <LinearLayout
            android:id="@+id/space_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_image_broken"
                app:tint="@color/text_disabled" />

            <TextView
                android:id="@+id/tv_media_empty"
                style="@style/Text.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap"
                android:gravity="center"
                android:text="@string/space_empty" />
        </LinearLayout>

        <!-- Multi-select bar, hidden by default: favourite / delete / export favourites (UI PRD §3.6 D / F) -->
        <LinearLayout
            android:id="@+id/gallery_toolbar_select"
            style="@style/Widget.LightShadowArtPhone.GalleryToolbar"
            android:layout_marginBottom="@dimen/gallery_toolbar_bottom_gap"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/btn_toolbar_fav"
                style="@style/Widget.LightShadowArtPhone.GalleryToolbar.Item">

                <ImageView
                    android:id="@+id/iv_toolbar_fav_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_favourite_outline"
                    app:tint="@color/primary_blue" />

                <TextView
                    style="@style/Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/space_favourite"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_toolbar_delete"
                style="@style/Widget.LightShadowArtPhone.GalleryToolbar.Item">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/status_destructive" />

                <TextView
                    style="@style/Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/space_delete"
                    android:textColor="@color/status_destructive"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_toolbar_export_fav"
                style="@style/Widget.LightShadowArtPhone.GalleryToolbar.Item">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_export"
                    app:tint="@color/primary_blue" />

                <TextView
                    style="@style/Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/space_export_fav"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>
        </LinearLayout>

        <!-- Paused full-screen bar: 70% grey background with white icons / labels (2026-10-20) -->
        <LinearLayout
            android:id="@+id/gallery_toolbar_playback"
            style="@style/Widget.LightShadowArtPhone.GalleryToolbar"
            android:layout_marginBottom="@dimen/gallery_toolbar_bottom_gap"
            android:background="@drawable/bg_gallery_toolbar_playback"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/btn_toolbar_playback_fav"
                style="@style/Widget.LightShadowArtPhone.GalleryToolbar.Item">

                <ImageView
                    android:id="@+id/iv_toolbar_fav_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_favourite_outline"
                    app:tint="@color/on_primary" />

                <TextView
                    style="@style/Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/space_favourite"
                    android:textColor="@color/on_primary"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_toolbar_frame"
                style="@style/Widget.LightShadowArtPhone.GalleryToolbar.Item">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_design"
                    app:tint="@color/on_primary" />

                <TextView
                    style="@style/Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/space_toolbar_frame"
                    android:textColor="@color/on_primary"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_toolbar_wall"
                style="@style/Widget.LightShadowArtPhone.GalleryToolbar.Item">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_backgrounds"
                    app:tint="@color/on_primary" />

                <TextView
                    style="@style/Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/space_toolbar_wall"
                    android:textColor="@color/on_primary"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_toolbar_rotate"
                style="@style/Widget.LightShadowArtPhone.GalleryToolbar.Item">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_rotate"
                    app:tint="@color/on_primary" />

                <TextView
                    style="@style/Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/space_rotate"
                    android:textColor="@color/on_primary"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>
        </LinearLayout>

        <com.ShowSeen.lightshadowart.mobile.DeviceControlPadView
            android:id="@+id/device_control_pad"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
