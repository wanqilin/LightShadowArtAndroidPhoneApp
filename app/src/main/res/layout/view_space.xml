<?xml version="1.0" encoding="utf-8"?>
<!--
    Space Art Gallery (UI PRD §3.6). Back arrow + title + read-only playback capsule on top,
    filter pills, the artwork itself (three-column grid, or a single scaled frame while the
    device is playing), a floating Design / Backgrounds / Layers / Reset toolbar and the floating
    collapsible device control pad.

    No palette entry lives up here: the palette belongs to the Design / Backgrounds pages.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <com.ShowSeen.lightshadowart.mobile.PageTopBarView
        android:id="@+id/space_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="@dimen/card_padding" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingEnd="@dimen/page_horizontal_padding">

        <!-- Filter pills: Immersive / By Date / Favs. Widths are shared, so nothing overlaps -->
        <LinearLayout
            android:id="@+id/row_space_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pill_space_immersive"
                style="@style/FilterPill"
                android:layout_weight="1"
                android:text="@string/space_mode_immersive" />

            <TextView
                android:id="@+id/pill_space_date"
                style="@style/FilterPill"
                android:layout_marginStart="@dimen/item_gap"
                android:layout_weight="1"
                android:text="@string/space_mode_date" />

            <TextView
                android:id="@+id/pill_space_favourite"
                style="@style/FilterPill"
                android:layout_marginStart="@dimen/item_gap"
                android:layout_weight="1"
                android:text="@string/space_mode_favourite" />
        </LinearLayout>

        <!--
            The gallery's remaining single-item actions. Kept to three per row so an English label
            such as "Ex.Fav" cannot wrap and stretch the pill.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_space_refresh"
                style="@style/PillButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/space_refresh"
                android:textSize="@dimen/text_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_space_select"
                style="@style/PillButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/space_select"
                android:textSize="@dimen/text_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_space_export_fav"
                style="@style/PillButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/space_export_fav"
                android:textSize="@dimen/text_hint" />
        </LinearLayout>

        <!-- Selection actions: only meaningful once the Select button has started multi-select -->
        <LinearLayout
            android:id="@+id/row_space_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_space_favourite"
                style="@style/PillButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/space_favourite"
                android:textSize="@dimen/text_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_space_delete"
                style="@style/PillButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:minWidth="0dp"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/space_delete"
                android:textSize="@dimen/text_hint" />
        </LinearLayout>
    </LinearLayout>

    <!-- The artwork area: grid, or the single frame the device is showing while it plays -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/item_gap"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/page_horizontal_padding"
            android:paddingEnd="@dimen/page_horizontal_padding"
            android:paddingBottom="@dimen/gallery_bottom_inset" />

        <!-- Now Playing: one scaled frame, tap to toggle auto play / pause (UI PRD §3.6 C2) -->
        <FrameLayout
            android:id="@+id/now_playing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_bg"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_now_playing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/page_horizontal_padding"
                android:layout_marginEnd="@dimen/page_horizontal_padding"
                android:layout_marginBottom="@dimen/gallery_bottom_inset"
                android:contentDescription="@string/space_now_playing_desc"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:id="@+id/progress_now_playing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tv_now_playing_status"
                style="@style/Text.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Empty state: only shown when the gallery really has nothing -->
        <LinearLayout
            android:id="@+id/space_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_image_broken"
                app:tint="@color/text_disabled" />

            <TextView
                android:id="@+id/tv_media_empty"
                style="@style/Text.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap"
                android:gravity="center"
                android:text="@string/space_empty" />
        </LinearLayout>

        <!-- Floating toolbar; the control pad sits above it so the two never overlap -->
        <LinearLayout
            android:id="@+id/gallery_toolbar"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/floating_toolbar_height"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/item_gap"
            android:background="@drawable/bg_floating_toolbar"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:id="@+id/btn_toolbar_design"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="68dp"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_design"
                    app:tint="@color/primary_blue" />

                <TextView
                    style="@style/Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/space_toolbar_design"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_toolbar_backgrounds"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="68dp"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_backgrounds"
                    app:tint="@color/primary_blue" />

                <TextView
                    style="@style/Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/space_toolbar_backgrounds"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_toolbar_layers"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="68dp"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_layers"
                    app:tint="@color/primary_blue" />

                <TextView
                    style="@style/Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/space_toolbar_layers"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_toolbar_reset"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="68dp"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_reset"
                    app:tint="@color/primary_blue" />

                <TextView
                    style="@style/Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/space_toolbar_reset"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>
        </LinearLayout>

        <com.ShowSeen.lightshadowart.mobile.DeviceControlPadView
            android:id="@+id/device_control_pad"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
