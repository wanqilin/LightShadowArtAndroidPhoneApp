<?xml version="1.0" encoding="utf-8"?>
<!--
    First-run guide, step 1 (UI PRD §3.1): the brand mark, the greeting and the language choice,
    matching the reference layout. The brand disc sits in the upper third with a generous size, the
    greeting lands around the middle of the page, the language cards sit just below it and Get
    Started hugs the bottom.

    The vertical gaps are weighted spacers, so on a tall screen the page spreads out instead of the
    copy clustering in the middle; the whole column scrolls when the screen is short or the system
    font is large.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_horizontal_padding"
            android:paddingTop="@dimen/page_vertical_padding"
            android:paddingEnd="@dimen/page_horizontal_padding"
            android:paddingBottom="@dimen/page_vertical_padding">

            <!-- Keeps the brand mark out of the very top of the screen -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.1" />

            <!-- Brand mark: a light cyan disc with the LS monogram -->
            <TextView
                android:id="@+id/tv_welcome_logo"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_logo_disc"
                android:gravity="center"
                android:text="@string/welcome_logo_mark"
                android:textColor="@color/primary_blue"
                android:textSize="44sp"
                android:textStyle="bold" />

            <!-- Wide gap so the greeting lands around the middle, as in the reference -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.4" />

            <TextView
                android:id="@+id/tv_welcome_title"
                style="@style/Text.TitleLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/welcome_title" />

            <TextView
                android:id="@+id/tv_welcome_subtitle"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/welcome_subtitle"
                android:textColor="@color/text_secondary" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.3" />

            <!-- The language prompt sits directly above the language cards, as in the reference -->
            <TextView
                style="@style/Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap"
                android:gravity="center"
                android:text="@string/welcome_choose_language" />

            <LinearLayout
                android:id="@+id/card_language_en"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_outline"
                android:clickable="true"
                android:contentDescription="@string/language_en"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding">

                <TextView
                    android:id="@+id/tv_language_en"
                    style="@style/Text.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:text="@string/language_en" />

                <ImageView
                    android:id="@+id/iv_language_en_check"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="invisible"
                    app:tint="@color/primary_blue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_language_zh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap"
                android:background="@drawable/bg_card_outline"
                android:clickable="true"
                android:contentDescription="@string/language_zh"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding">

                <TextView
                    android:id="@+id/tv_language_zh"
                    style="@style/Text.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:text="@string/language_zh" />

                <ImageView
                    android:id="@+id/iv_language_zh_check"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="invisible"
                    app:tint="@color/primary_blue" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_welcome_start"
                style="@style/PillButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_get_started" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
