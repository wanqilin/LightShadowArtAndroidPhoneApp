<?xml version="1.0" encoding="utf-8"?>
<!--
    添加边框二级页（F-6）：由空间页「添加边框」入口进入（原「边框预设」弹窗已随之删除）。

    用户口径（F-6 第二轮）：**整页不滚动**——上下滑动很容易误触发，因此这里不放 ScrollView，
    控件压缩到一屏内；参数顺序为 样式 → ①边框与图片的距离 → ⑤两个边框的间距 →
    ②边框与外边界的距离 → ④线宽 → ③颜色 → Apply to device（线宽排在边距之后）。
    颜色收成一行「③ 边框颜色 + 色块预览」，点击进入独立的 FrameColorActivity 选色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- 页头：返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_add_frame_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Text.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/space_add_frame" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- 样式：列表由设备端 GET /frame 的 styles[] 下发，客户端不硬编码样式名 -->
        <TextView
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frame_style" />

        <Spinner
            android:id="@+id/spinner_add_frame_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ① 边框与图片的距离 -->
        <TextView
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/add_frame_padding" />

        <EditText
            android:id="@+id/et_add_frame_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <!-- ⑤ 两个边框的间距（内边框 ↔ 外边框） -->
        <TextView
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/add_frame_border_gap" />

        <EditText
            android:id="@+id/et_add_frame_border_gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <!-- ② 边框与外边界的距离 -->
        <TextView
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/add_frame_inset" />

        <EditText
            android:id="@+id/et_add_frame_inset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <!-- ④ 线宽：只对带粗细的样式（如简单线条框）生效，设备端对其它样式忽略该值 -->
        <TextView
            style="@style/Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/add_frame_width" />

        <EditText
            android:id="@+id/et_add_frame_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <!-- ③ 颜色：本页只留一行标签 + 色块预览，点进 FrameColorActivity 用色盘 + R/G/B 选色 -->
        <LinearLayout
            android:id="@+id/row_add_frame_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.RowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_frame_color" />

            <View
                android:id="@+id/view_add_frame_preview"
                android:layout_width="64dp"
                android:layout_height="36dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_frame_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/frame_apply" />
    </LinearLayout>
</LinearLayout>
