<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-screen scanner page (UI PRD §3.2 B): the camera preview fills the whole content area, with a
    light guide layer on top — back button, title and a one-line instruction — instead of the
    centered square viewfinder the stock layout draws. Decoding covers the entire preview
    (see ScanBarcodeView), so the user only has to get the code on screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_scanner_layout="@layout/scan_barcode_scanner" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_scan_scrim"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="@dimen/page_vertical_padding">

        <ImageButton
            android:id="@+id/btn_scan_back"
            android:layout_width="@dimen/touch_min_height"
            android:layout_height="@dimen/touch_min_height"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/on_scrim" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="@string/scan_title"
            android:textColor="@color/on_scrim"
            android:textSize="@dimen/text_title_large"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="@string/scan_prompt"
            android:textColor="@color/on_scrim_secondary"
            android:textSize="@dimen/text_body" />
    </LinearLayout>
</FrameLayout>
