<?xml version="1.0" encoding="utf-8"?>
<!--
    Main Dashboard (UI PRD §3.3, v3.0 two-part layout): the upper half is a read-only brand block —
    logo, brand name with a live state dot beside it, and the brand subtitle — and the lower half is
    the 2x2 card group anchored to the bottom: Space Art Gallery / Network Connection on top,
    Upload Media / Settings below.

    No bottom tab bar: the four cards are the whole navigation surface. The brand block is not
    clickable and carries no chevron, so it cannot be mistaken for a fifth entry.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_horizontal_padding"
            android:paddingTop="@dimen/page_vertical_padding"
            android:paddingEnd="@dimen/page_horizontal_padding"
            android:paddingBottom="@dimen/page_vertical_padding">

            <!-- ===== Upper half: brand block, display only ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_dashboard_logo"
                    android:layout_width="@dimen/dashboard_logo_size"
                    android:layout_height="@dimen/dashboard_logo_size"
                    android:layout_marginTop="@dimen/dashboard_brand_top_offset"
                    android:background="@drawable/bg_logo_disc"
                    android:gravity="center"
                    android:text="@string/welcome_logo_mark"
                    android:textColor="@color/on_primary"
                    android:textSize="@dimen/text_dashboard_logo"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dashboard_brand_gap">

                    <TextView
                        android:id="@+id/tv_dashboard_brand"
                        style="@style/Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:text="@string/app_name"
                        android:textSize="@dimen/text_dashboard_brand" />

                    <View
                        android:id="@+id/view_dashboard_dot"
                        android:layout_width="@dimen/dashboard_dot_size"
                        android:layout_height="@dimen/dashboard_dot_size"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/dashboard_dot_gap"
                        android:layout_toEndOf="@id/tv_dashboard_brand"
                        android:background="@drawable/dot_session" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tv_dashboard_subtitle"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dashboard_subtitle_gap"
                    android:text="@string/welcome_subtitle"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Flexible gap: keeps the 2x2 card group anchored to the bottom of the page -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- ===== Lower half: fixed 2x2 card group ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dashboard_card_group_min_gap"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_gallery"
                    style="@style/SurfaceCard.Clickable"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dashboard_card_height"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <ImageView
                            android:layout_width="@dimen/icon_badge_box"
                            android:layout_height="@dimen/icon_badge_box"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_palette"
                            app:tint="@color/primary_blue" />

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/item_gap"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/space_title" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_network"
                    style="@style/SurfaceCard.Clickable"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dashboard_card_height"
                    android:layout_marginStart="@dimen/item_gap"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <ImageView
                            android:layout_width="@dimen/icon_badge_box"
                            android:layout_height="@dimen/icon_badge_box"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_network"
                            app:tint="@color/primary_blue" />

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/item_gap"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/network_title" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Extra bottom margin lifts the whole card group slightly off the page edge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap"
                android:layout_marginBottom="@dimen/dashboard_card_group_bottom_gap"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_upload"
                    style="@style/SurfaceCard.Clickable"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dashboard_card_height"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <ImageView
                            android:layout_width="@dimen/icon_badge_box"
                            android:layout_height="@dimen/icon_badge_box"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_upload_cloud"
                            app:tint="@color/primary_blue" />

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/item_gap"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/dashboard_upload_media" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_settings"
                    style="@style/SurfaceCard.Clickable"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dashboard_card_height"
                    android:layout_marginStart="@dimen/item_gap"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <ImageView
                            android:layout_width="@dimen/icon_badge_box"
                            android:layout_height="@dimen/icon_badge_box"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_settings_gear"
                            app:tint="@color/primary_blue" />

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/item_gap"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/dashboard_frame_settings" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Store mode only: create the next customer folder -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_studio_folder"
                style="@style/PillButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/action_studio_folder"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Upload progress: hidden until something is uploading, then pinned under the cards -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_uploads"
        style="@style/SurfaceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_horizontal_padding"
        android:layout_marginEnd="@dimen/page_horizontal_padding"
        android:layout_marginBottom="@dimen/item_gap"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/tv_upload_summary"
                style="@style/Text.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upload_summary_empty" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_uploads"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
