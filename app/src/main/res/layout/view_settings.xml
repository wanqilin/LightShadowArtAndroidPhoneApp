<?xml version="1.0" encoding="utf-8"?>
<!-- 右栏：设置 —— 一级菜单（身份类型 + 参数设置 / 关于），点入为二级页面（需求 6.3） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 一级：设置菜单 -->
    <ScrollView
        android:id="@+id/settings_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Text.PageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tab_settings" />

            <!-- 用户身份类型：家庭/门店模式 × 管理员/共享用户(选片用户)，小号灰字，标题下方一行 -->
            <TextView
                android:id="@+id/tv_settings_identity"
                style="@style/Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <!-- 分组卡片：参数设置 / 关于 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <!-- 参数设置入口（二级页面） -->
                <LinearLayout
                    android:id="@+id/btn_settings_params"
                    style="@style/Settings.Row.Clickable">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_title" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <!-- 关于入口（二级页面） -->
                <LinearLayout
                    android:id="@+id/btn_settings_about"
                    style="@style/Settings.Row.Clickable">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_about" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <!--
                「退出账号」＝移交管理权（需求 5.7.2 / T-7）：家庭 / 门店共用同一入口，
                仅管理员可见（applySettingsRole 控制）；退出后设备端解除绑定并主动弹出二维码，
                供其他人扫码接管管理员。
            -->
            <LinearLayout
                android:id="@+id/btn_settings_logout"
                style="@style/Settings.Row.Clickable"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:visibility="gone">

                <TextView
                    style="@style/Text.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_logout" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 二级：参数设置 -->
    <ScrollView
        android:id="@+id/settings_params_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- 页头：返回 + 标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_settings_params_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_back"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_back" />

                <TextView
                    style="@style/Text.PageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/settings_title" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_settings_hint"
                style="@style/Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_admin_hint" />

            <!-- 参数分组卡片：右侧就地编辑 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_heartbeat" />

                    <EditText
                        android:id="@+id/et_heartbeat"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="end"
                        android:inputType="number"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_session_timeout" />

                    <EditText
                        android:id="@+id/et_session_timeout"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="end"
                        android:inputType="number"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_no_op_countdown" />

                    <EditText
                        android:id="@+id/et_no_op_countdown"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="end"
                        android:inputType="number"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_auto_play" />

                    <EditText
                        android:id="@+id/et_auto_play"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="end"
                        android:inputType="number"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/settings_save" />
        </LinearLayout>
    </ScrollView>

    <!-- 二级：关于 -->
    <ScrollView
        android:id="@+id/settings_about_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- 页头：返回 + 标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_settings_about_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_back"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_back" />

                <TextView
                    style="@style/Text.PageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/settings_about" />
            </LinearLayout>

            <!-- 版本信息卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/about_label_mobile_version" />

                    <TextView
                        android:id="@+id/tv_about_mobile_version"
                        style="@style/Text.RowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/divider" />

                <LinearLayout style="@style/Settings.Row">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/about_label_device_version" />

                    <TextView
                        android:id="@+id/tv_about_device_version"
                        style="@style/Text.RowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- 版权信息 -->
            <TextView
                android:id="@+id/tv_about_copyright"
                style="@style/Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
