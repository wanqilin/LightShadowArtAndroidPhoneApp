<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings (UI PRD §3.7). Language / Advanced Settings / About and Version as grouped cards plus
    a light destructive "Disconnect and exit" at the bottom. The Wi-Fi entry is gone on purpose:
    network configuration lives on the Network Connection page only.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- Level 1: the settings menu -->
    <LinearLayout
        android:id="@+id/settings_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.ShowSeen.lightshadowart.mobile.PageTopBarView
            android:id="@+id/settings_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="@dimen/card_padding" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_horizontal_padding"
                android:paddingTop="@dimen/item_gap"
                android:paddingEnd="@dimen/page_horizontal_padding"
                android:paddingBottom="@dimen/page_vertical_padding">

                <!-- Current identity: home admin or studio admin / selection user -->
                <TextView
                    android:id="@+id/tv_settings_identity"
                    style="@style/Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/SurfaceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/btn_settings_language"
                            style="@style/Settings.Row.Clickable">

                            <ImageView
                                style="@style/Settings.Row.Icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_language"
                                app:tint="@color/primary_blue" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/item_gap"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Text.RowTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_language" />

                                <TextView
                                    style="@style/Text.Hint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_language_summary" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_settings_language_value"
                                style="@style/Text.RowValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>

                        <View style="@style/Settings.Divider" />

                        <LinearLayout
                            android:id="@+id/btn_settings_params"
                            style="@style/Settings.Row.Clickable">

                            <ImageView
                                style="@style/Settings.Row.Icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_settings_gear"
                                app:tint="@color/primary_blue" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/item_gap"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Text.RowTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_advanced_title" />

                                <TextView
                                    style="@style/Text.Hint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_advanced_summary" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/SurfaceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap">

                    <LinearLayout
                        android:id="@+id/btn_settings_about"
                        style="@style/Settings.Row.Clickable">

                        <ImageView
                            style="@style/Settings.Row.Icon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info"
                            app:tint="@color/primary_blue" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/item_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.RowTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_about" />

                            <TextView
                                style="@style/Text.Hint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_about_summary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--
                    "Sign out" = hand the administrator role over (administrator only): the device
                    unbinds and shows its QR code so somebody else can take over.
                -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/SurfaceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap">

                    <LinearLayout
                        android:id="@+id/btn_settings_logout"
                        style="@style/Settings.Row.Clickable"
                        android:visibility="gone">

                        <ImageView
                            style="@style/Settings.Row.Icon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_power"
                            app:tint="@color/status_destructive" />

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/item_gap"
                            android:layout_weight="1"
                            android:text="@string/settings_disconnect_exit"
                            android:textColor="@color/status_destructive" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Level 2: advanced parameters (administrator only) -->
    <LinearLayout
        android:id="@+id/settings_params_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_bg"
        android:orientation="vertical"
        android:visibility="gone">

        <com.ShowSeen.lightshadowart.mobile.PageTopBarView
            android:id="@+id/settings_params_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="@dimen/card_padding" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_horizontal_padding"
                android:paddingTop="@dimen/item_gap"
                android:paddingEnd="@dimen/page_horizontal_padding"
                android:paddingBottom="@dimen/page_vertical_padding">

                <TextView
                    android:id="@+id/tv_settings_hint"
                    style="@style/Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_admin_hint" />

                <!-- Each row carries its own divider; hiding a row hides its divider too -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/SurfaceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/row_settings_heartbeat"
                            style="@style/Settings.Row">

                            <TextView
                                style="@style/Text.RowTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_heartbeat" />

                            <EditText
                                android:id="@+id/et_heartbeat"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:gravity="end"
                                android:inputType="number"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_row_title" />
                        </LinearLayout>

                        <View
                            android:id="@+id/divider_settings_heartbeat"
                            style="@style/Settings.Divider" />

                        <LinearLayout
                            android:id="@+id/row_settings_session_timeout"
                            style="@style/Settings.Row">

                            <TextView
                                style="@style/Text.RowTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_session_timeout" />

                            <EditText
                                android:id="@+id/et_session_timeout"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:gravity="end"
                                android:inputType="number"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_row_title" />
                        </LinearLayout>

                        <View
                            android:id="@+id/divider_settings_session_timeout"
                            style="@style/Settings.Divider" />

                        <LinearLayout
                            android:id="@+id/row_settings_no_op_countdown"
                            style="@style/Settings.Row">

                            <TextView
                                style="@style/Text.RowTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_no_op_countdown" />

                            <EditText
                                android:id="@+id/et_no_op_countdown"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:gravity="end"
                                android:inputType="number"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_row_title" />
                        </LinearLayout>

                        <View
                            android:id="@+id/divider_settings_no_op_countdown"
                            style="@style/Settings.Divider" />

                        <LinearLayout
                            android:id="@+id/row_settings_auto_play"
                            style="@style/Settings.Row">

                            <TextView
                                style="@style/Text.RowTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_auto_play" />

                            <EditText
                                android:id="@+id/et_auto_play"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:gravity="end"
                                android:inputType="number"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_row_title" />
                        </LinearLayout>

                        <View
                            android:id="@+id/divider_settings_auto_play"
                            style="@style/Settings.Divider" />

                        <!-- Default frame / background: the fallback every un-customised picture uses -->
                        <LinearLayout
                            android:id="@+id/btn_settings_frame_default"
                            style="@style/Settings.Row.Clickable">

                            <ImageView
                                style="@style/Settings.Row.Icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_settings_gear"
                                app:tint="@color/primary_blue" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/item_gap"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Text.RowTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_frame_default" />

                                <TextView
                                    style="@style/Text.Hint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_frame_default_summary" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right" />
                        </LinearLayout>

                        <View
                            android:id="@+id/divider_settings_frame_default"
                            style="@style/Settings.Divider" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_settings_save"
                    style="@style/PillButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:text="@string/settings_save" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
