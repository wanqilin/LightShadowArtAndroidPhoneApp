<?xml version="1.0" encoding="utf-8"?>
<!-- Selectable card in its selected state: white card with a primary blue stroke -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/card_bg" />
    <stroke
        android:width="2dp"
        android:color="@color/primary_blue" />
    <corners android:radius="@dimen/corner_large" />
</shape>
