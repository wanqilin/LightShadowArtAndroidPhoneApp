<?xml version="1.0" encoding="utf-8"?>
<!-- Unselected multi-select marker: empty square with a white outline, sitting on any picture -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/check_backdrop" />
    <stroke
        android:width="2dp"
        android:color="@color/on_primary" />
    <corners android:radius="5dp" />
</shape>
