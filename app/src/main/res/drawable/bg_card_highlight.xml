<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Connection card background: white fading into a very light cyan-teal tint.
    Only a local gradient (UI PRD §2.1), never a full-page one.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="@color/card_highlight_end"
        android:startColor="@color/card_bg"
        android:type="linear" />
    <stroke
        android:width="@dimen/divider_width"
        android:color="@color/divider_stroke" />
    <corners android:radius="@dimen/corner_large" />
</shape>
