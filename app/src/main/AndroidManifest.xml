<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!--
        requestNetwork(带 WifiNetworkSpecifier) 会被 ConnectivityService.enforceChangePermission
        拦下，要求持有 CHANGE_NETWORK_STATE 或 WRITE_SETTINGS 之一。CHANGE_NETWORK_STATE 是
        normal 级权限（安装即授予），声明后即可通过校验；WRITE_SETTINGS 需用户到系统设置手动授权。
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        NSD(mDNS) 发现：Android 的 Wi-Fi 省电策略会过滤组播包，
        需要 MulticastLock 才能稳定收到 mDNS 响应，声明该权限后运行时再持有锁。
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
        自动接入设备热点：Android 13+ 用「附近的设备」。
        这里不加 neverForLocation：本 App 确实要读 Wi-Fi 扫描列表（「连接 Wi-Fi」页让用户选网络），
        而扫描结果本身就带位置信息，按位置类用途声明才不会拿到被系统过滤/置空的结果。
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        tools:targetApi="tiramisu" />

    <!--
        读取「当前 Wi-Fi 名」与「Wi-Fi 列表」：官方文档明确 getScanResults()/startScan() 即使
        targetSdk 33+ 也仍然要求 ACCESS_FINE_LOCATION，因此不能再限制 maxSdkVersion="32"
        （限制后 Android 13+ 上等于没有该权限，列表恒为空、SSID 被抹成 <unknown ssid>）。
        同时要 COARSE：Android 12+ 只给「大概位置」时精确位置仍为拒绝，扫描列表同样读不到。
        仅用于读取网络名，不采集位置信息。
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightShadowArtPhone"
        android:usesCleartextTraffic="true">

        <!--
            First-run guide step 1 is the launcher: it forwards straight to the Dashboard when a
            device has already been bound, so the guide is only ever seen once per install.
        -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-run guide step 2: scan the frame QR code; hands the payload to the Dashboard -->
        <activity
            android:name=".BindDeviceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Dashboard and the Space / Settings pages it hosts (no bottom tab bar) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Network Connection: the only place to reconnect / disconnect / configure Wi-Fi -->
        <activity
            android:name=".NetworkConnectionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- About and version; opened from Settings -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".WifiConfigActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 语言选择二级页面（F-3）：由设置页「语言」入口进入，选中即生效 -->
        <activity
            android:name=".LanguageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Frame Design (UI PRD §3.8): reached from the Space toolbar, administrator + static playback only -->
        <activity
            android:name=".FrameDesignActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Backgrounds (UI PRD §3.10): wallpaper / solid fill behind the photo -->
        <activity
            android:name=".BackgroundsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Line colour picker (UI PRD §3.9): HSV sub-page of Frame Design and Backgrounds -->
        <activity
            android:name=".LineColorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!--
            ZXing 内置的 CaptureActivity 在库清单里被写死为 sensorLandscape（横屏），
            这里用 tools:replace 覆盖成竖屏，使取景器与手机方向一致。
        -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />

        <!-- 自定义扫码页：竖屏取景 + 顶部标题 + 取景框下方提示 -->
        <activity
            android:name=".scan.ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!--
            中英文切换（需求 5.7.3 / T-8）：autoStoreLocales=true 让 AppCompat 自己把
            setApplicationLocales() 的选择持久化到本地，重启后保持，无需另写 SharedPreferences。
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
